    "@uni-status/enterprise": "workspace:*",
    "@uni-status/shared": "workspace:*",
    "amqplib": "^0.10.9",
    "bullmq": "^5.81.5",
    "drizzle-orm": "^0.45.4",
    "ioredis": "5.11.1",
    "irc-framework": "^4.14.0",
    "mongodb": "^7.7.0",
