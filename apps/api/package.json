    "@resvg/resvg-js": "^2.6.2",
    "@uni-status/auth": "workspace:*",
    "@uni-status/database": "workspace:*",
    "@uni-status/email": "workspace:*",
    "@uni-status/enterprise": "workspace:*",
    "@uni-status/shared": "workspace:*",
    "bullmq": "^5.81.5",
    "drizzle-orm": "^0.45.4",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.6",
    "hono": "^4.13.13",
    "ioredis": "5.11.1",
    "nanoid": "^5.1.16",
    "puppeteer": "^24.43.1",
    "react": "^19.3.1",
    "satori": "^0.25.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
